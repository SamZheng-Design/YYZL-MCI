{
  "name": "zhongliu-connect",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tailwindcss -i src/tailwind.css -o public/static/tailwind.css --minify && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name zhongliu-connect",
    "dev:sandbox": "wrangler pages dev dist --d1=zhongliu-production --local --ip 0.0.0.0 --port 3000",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",

    "db:migrate:local": "wrangler d1 migrations apply zhongliu-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply zhongliu-production",
    "db:seed": "wrangler d1 execute zhongliu-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console": "wrangler d1 execute zhongliu-production --local",
    "db:console:prod": "wrangler d1 execute zhongliu-production"
  },
  "dependencies": {
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
